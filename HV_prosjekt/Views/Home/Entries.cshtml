@{
    ViewData["Title"] = "Saved entries";
}

<h2>Saved GeoJSON entries</h2>

<div id="entries"></div>

@section Scripts {
<script>
async function loadEntries() {
    try {
        const res = await fetch('/api/mapentries');
        if (!res.ok) return document.getElementById('entries').textContent = 'Failed to load entries';
        const entries = await res.json();
        const container = document.getElementById('entries');
        if (entries.length === 0) { container.textContent = 'No entries saved.'; return; }
        container.innerHTML = '';
        entries.forEach(e => {
            const div = document.createElement('div');
            div.style.border = '1px solid #ccc';
            div.style.padding = '8px';
            div.style.marginBottom = '8px';
            const h = document.createElement('h3');
            h.textContent = e.title || ('Entry ' + e.id);
            const pre = document.createElement('pre');
            pre.textContent = e.geoJson;
            const del = document.createElement('button');
            del.textContent = 'Delete';
            del.addEventListener('click', async () => {
                const r = await fetch('/api/mapentries/' + e.id, { method: 'DELETE' });
                if (r.ok) loadEntries(); else alert('Delete failed');
            });
            div.appendChild(h);
            div.appendChild(pre);
            div.appendChild(del);
            container.appendChild(div);
        });
    } catch (err) { document.getElementById('entries').textContent = 'Error loading entries'; }
}
loadEntries();
</script>
}
