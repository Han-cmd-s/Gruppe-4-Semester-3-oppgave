
@model HV_prosjekt.Models.PositionModel

<div>
	<button id="saveGeo" class="btn btn-primary" style="margin-bottom:8px;">Save selection as GeoJSON</button>
</div>
<div id="map" style="width: 100%; height: 500px;"></div>

@section Scripts {
<script>
	var map = L.map('map').setView([58.14671, 7.9956], 13);
	L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
		attribution: '&copy; OpenStreetMap contributors'
	}).addTo(map);

	// keep track of locally created markers
	const createdMarkers = [];

	// add a marker to map and to local list
	function addLocalMarker(latlng) {
		const marker = L.marker(latlng, { draggable: true }).addTo(map);
		marker.on('dragend', function () {
			// popup content stays in sync when dragged
			const pos = marker.getLatLng();
			marker.setPopupContent('Lat: ' + pos.lat.toFixed(6) + ', Lng: ' + pos.lng.toFixed(6));
		});
		marker.bindPopup('Lat: ' + latlng.lat.toFixed(6) + ', Lng: ' + latlng.lng.toFixed(6));
		createdMarkers.push(marker);
		return marker;
	}

	// map click creates a local marker
	map.on('click', function (e) {
		addLocalMarker(e.latlng).openPopup();
	});

	// build GeoJSON FeatureCollection from createdMarkers
	function buildGeoJSONFromMarkers() {
		const features = createdMarkers.map(m => {
			const ll = m.getLatLng();
			return {
				type: 'Feature',
				geometry: { type: 'Point', coordinates: [ll.lng, ll.lat] },
				properties: {}
			};
		});
		return { type: 'FeatureCollection', features };
	}

	// save GeoJSON to in-memory store
	document.getElementById('saveGeo').addEventListener('click', async function () {
		if (createdMarkers.length === 0) { alert('No markers to save'); return; }
		const geo = buildGeoJSONFromMarkers();
		const title = prompt('Title for this entry', 'Map selection');
		try {
			const res = await fetch('/api/mapentries', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ title: title, geoJson: JSON.stringify(geo) })
			});
			if (!res.ok) { alert('Failed to save'); return; }
			alert('Saved');
			// clear local markers
			createdMarkers.forEach(m => m.remove());
			createdMarkers.length = 0;
			// refresh entries on map
			loadEntriesToMap();
		} catch (err) { console.error(err); alert('Error saving entry'); }
	});

	// load saved entries from server and render their GeoJSON
	async function loadEntriesToMap() {
		try {
			const res = await fetch('/api/mapentries');
			if (!res.ok) return console.error('Failed to load entries');
			const entries = await res.json();
			// clear existing non-local layers (optional)
			// add each feature collection to the map
			entries.forEach(e => {
				try {
					const gj = JSON.parse(e.geoJson);
					L.geoJSON(gj, {
						pointToLayer: function (feature, latlng) {
							return L.marker(latlng);
						}
					}).addTo(map);
				} catch (err) {
					console.error('Invalid geojson for entry', e.id, err);
				}
			});
		} catch (err) { console.error(err); }
	}

	// initial load
	loadEntriesToMap();
</script>
}
